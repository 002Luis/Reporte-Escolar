# Copia este archivo como .env y completa tus valores
# Los encuentras en tu proyecto de Supabase: Settings → API

# Project URL (Settings → API → Project URL)
# Ejemplo: https://zvsenxrwlajbfdcphviu.supabase.co
# SOLO cambia el codigo, ej: https://XXXXXXXX.supabase.co
SUPABASE_URL=codigodetuproyecto.supabase.co

# Publishable / anon key (Settings → API → Publishable key)
# Empieza con sb_publishable_
SUPABASE_ANON_KEY=sb_publishable_xxxx